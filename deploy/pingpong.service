[Unit]
Description=Table tennis split bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pingpong-split-bot
ExecStart=/home/ubuntu/pingpong-split-bot/.venv/bin/python -u bot.py
# the watchdog exits on a wedged connection; systemd is what brings it back
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
